# Every model call goes through OpenRouter (an OpenAI-compatible API).
OPENROUTER_KEY=

# LangSmith cloud. Use https://eu.api.smith.langchain.com for the EU region.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Langfuse, self-hosted with its docker compose file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Phoenix runs at http://localhost:6006 with auth off; phoenix-loop.ts needs no key.

# AcruxCore, self-hosted with docker-compose.local.yml. A member key: team keys cannot write prompts.
ACRUXCORE_API_KEY=
ACRUXCORE_BASE_URL=http://localhost:3001/api/v1
